# ─────────────────────────────────────────────────────────────────────────────
# google-search-console-mcp-server configuration
# Either provide the three OAuth values, or a single short-lived access token.
# ─────────────────────────────────────────────────────────────────────────────

# OAuth client, created in a Google Cloud project with the Search Console API
# enabled. Use a Desktop app client for local use.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=

# Refresh token obtained once through the OAuth consent flow, for a Google
# account that owns or can read the properties.
# The webmasters.readonly scope is enough.
GSC_REFRESH_TOKEN=

# Alternative to the three values above: a short-lived access token. Useful for
# a quick trial, useless for daily work since it expires within the hour.
# GSC_ACCESS_TOKEN=

# Optional. Saves passing siteUrl on every call. Either form works:
#   https://example.com/     (URL-prefix property)
#   sc-domain:example.com    (domain property)
# GSC_SITE_URL=

# debug | info | warn | error
# LOG_LEVEL=info
